{
  "realm": "vulntrack",
  "displayName": "VulnTrack",
  "loginTheme": "vulntrack",
  "enabled": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "roles": {
    "client": {
      "vulntrack": [
        { "name": "analyst", "description": "Views, creates, updates and assigns findings" },
        { "name": "developer", "description": "Views findings and updates their status and details" },
        { "name": "pm", "description": "Everything an analyst can do, plus SLA targets and user roles" },
        { "name": "auditor", "description": "Read-only access to findings, reports and audit logs" }
      ]
    }
  },
  "clientScopeMappings": {
    "realm-management": [{ "client": "vulntrack", "roles": ["view-users", "view-clients"] }]
  },
  "clients": [
    {
      "clientId": "vulntrack",
      "name": "VulnTrack",
      "enabled": true,
      "publicClient": false,
      "secret": "${OIDC_CLIENT_SECRET}",
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "redirectUris": ["http://localhost:8000/signin-oidc"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8000/signout-callback-oidc"
      },
      "protocolMappers": [
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "vulntrack",
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-vulntrack",
      "enabled": true,
      "serviceAccountClientId": "vulntrack",
      "clientRoles": { "realm-management": ["view-users", "view-clients"] }
    },
    {
      "username": "analyst",
      "email": "analyst@vulntrack.test",
      "firstName": "Alex",
      "lastName": "Analyst",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "analyst-test-pw", "temporary": false }],
      "clientRoles": { "vulntrack": ["analyst"] }
    },
    {
      "username": "developer",
      "email": "developer@vulntrack.test",
      "firstName": "Dana",
      "lastName": "Developer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "developer-test-pw", "temporary": false }],
      "clientRoles": { "vulntrack": ["developer"] }
    },
    {
      "username": "pm",
      "email": "pm@vulntrack.test",
      "firstName": "Parker",
      "lastName": "Manager",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "pm-test-password", "temporary": false }],
      "clientRoles": { "vulntrack": ["pm"] }
    },
    {
      "username": "auditor",
      "email": "auditor@vulntrack.test",
      "firstName": "Avery",
      "lastName": "Auditor",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "auditor-test-pw", "temporary": false }],
      "clientRoles": { "vulntrack": ["auditor"] }
    }
  ]
}
